    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/missing.py\""},
          {"type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/unterminated.py"},
